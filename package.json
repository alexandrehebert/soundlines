{
  "name": "soundlines",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "dev:site": "vite --config site/vite.config.ts",
    "build:site": "node site/scripts/build.ts",
    "preview:site": "vite preview --config site/vite.config.ts",
    "test:site": "tsc -p site && vitest run --config site/vite.config.ts",
    "start": "next start",
    "vercel-build": "next build",
    "lint": "oxlint --ignore-pattern .next",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "review-status": "node scripts/graph/reviewStatus.ts",
    "validate:graph": "vitest run src/data src/graph"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "motion": "^13.4.1",
    "next": "^16.3.0",
    "next-intl": "^4.14.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
