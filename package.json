{
  "name": "soundlines",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "pnpm --filter @soundlines/web run dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @soundlines/web run build",
    "start": "pnpm --filter @soundlines/web run start",
    "dev:site": "pnpm --filter @soundlines/companion run dev",
    "build:site": "pnpm --filter @soundlines/companion run build",
    "build:media": "pnpm --filter @soundlines/media run build",
    "build:pages": "pnpm build:site && pnpm build-storybook:public && pnpm build:media && node apps/companion/scripts/assemble-pages.ts",
    "preview:site": "pnpm --filter @soundlines/companion run preview",
    "test:site": "pnpm --filter @soundlines/companion run typecheck && pnpm --filter @soundlines/companion run test",
    "lint": "oxlint --ignore-pattern .next",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "check:push": "pnpm --filter @soundlines/web run typecheck && pnpm test",
    "storybook": "pnpm --filter @soundlines/storybook run dev",
    "build-storybook": "pnpm --filter @soundlines/storybook run build",
    "build-storybook:public": "pnpm --filter @soundlines/storybook run build:public",
    "review-status": "node scripts/graph/reviewStatus.ts",
    "validate:graph": "node scripts/graph/validateAddedOn.ts && vitest run packages/catalogue apps/web/src/graph scripts/graph",
    "changelog": "node scripts/changelog/generate.ts",
    "test:changelog": "vitest run scripts/changelog"
  },
  "dependencies": {
    "@soundlines/catalogue": "workspace:*",
    "@soundlines/project-config": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "31.0.1",
    "oxlint": "1.90.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "turbo": "^2.9.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
